/**index.wxss**/

.van-cell__value {
  margin-right: 10rpx;
}

.table-container {
  margin-top: 100rpx;
}

.close-btn {
  display: block;
  margin-bottom: 10rpx;
}

.qrcode-container {
  margin-top: 40rpx;
  text-align: center;
  display: block;
  position: unset;
}

